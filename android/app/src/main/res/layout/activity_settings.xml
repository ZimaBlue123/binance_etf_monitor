<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 定时任务 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ 定时任务"
            android:textColor="#f5b800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="默认每个工作日 14:30 跑监控;可改成任意时间。"
            android:textColor="#9aa0b4"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时间  "
                android:textColor="#cccccc" />

            <EditText
                android:id="@+id/schedule_hour"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:hint="HH"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="2"
                android:textColor="#ffffff"
                android:textColorHint="#555566" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : "
                android:textColor="#cccccc" />

            <EditText
                android:id="@+id/schedule_minute"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:hint="MM"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="2"
                android:textColor="#ffffff"
                android:textColorHint="#555566" />

            <CheckBox
                android:id="@+id/schedule_weekdays_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="仅工作日"
                android:textColor="#cccccc"
                android:layout_marginStart="20dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/schedule_next_trigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下次触发: -"
            android:textColor="#9aa0b4"
            android:textSize="12sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/schedule_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态: -"
            android:textColor="#9aa0b4"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/schedule_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💾 保存并启用" />

            <Button
                android:id="@+id/schedule_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🗑 删除定时" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#222244"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- ===== 基金列表 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 基金列表"
            android:textColor="#f5b800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="格式:每行一只基金,代码和名称用空格/逗号/制表符分隔"
            android:textColor="#9aa0b4"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="示例:  000001,华夏成长  /  096001 招商中证白酒"
            android:textColor="#666688"
            android:textSize="11sp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/fund_input"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:fontFamily="monospace"
            android:background="#0f1020"
            android:textColor="#d8d8e8"
            android:textColorHint="#555566"
            android:gravity="top"
            android:hint="000001,华夏成长\n096001,招商中证白酒"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="10dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/fund_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前 0 条记录"
            android:textColor="#9aa0b4"
            android:textSize="12sp"
            android:paddingTop="4dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/fund_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💾 保存" />

            <Button
                android:id="@+id/fund_paste"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📋 粘贴" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/fund_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧹 清空" />

            <Button
                android:id="@+id/fund_restore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="↩️ 恢复默认" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>